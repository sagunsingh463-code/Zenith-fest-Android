        "url": {
          "raw": "{{baseUrl}}/api/registrations?event_id=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "registrations"],
          "query": [
            { "key": "event_id", "value": "1" }
          ]
        },
        "description": "Lists student registrations filtered for Event #1."
      },
      "response": []
    },
    {
      "name": "10. GET /api/stats (Live Dashboard Metrics)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/stats",
          "host": ["{{baseUrl}}"],
          "path": ["api", "stats"]
        },
        "description": "Fetches live stats: total_events, total_registrations, total_capacity, overall_utilization_pct, upcoming_events_count, events_by_category."
      },
      "response": []
    },
    {
      "name": "11. POST /api/events [Stretch Goal - Create Event]",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Robo Soccer Cup\",\n  \"category\": \"Technical\",\n  \"icon\": \"⚽\",\n  \"event_date\": \"2026-11-15\",\n  \"event_time\": \"03:00 PM\",\n  \"venue\": \"Robotics Arena\",\n  \"capacity\": 32,\n  \"fee\": 50,\n  \"description\": \"Autonomous bot soccer championship with knockouts.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"]
        },
        "description": "Admin capability to create a new fest event. Expected status: 201 Created."
      },
      "response": []
    },
    {
      "name": "12. DELETE /api/registrations/{id} [Stretch Goal - Cancel Registration]",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/registrations/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "registrations", "1"]
        },
        "description": "Admin capability to cancel a registration, restoring event seat count immediately."
      },
      "response": []
