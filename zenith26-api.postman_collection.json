          "path": ["api", "registrations"]
        },
        "description": "Lists all student registrations across events with joined event_title."
      },
      "response": []
    },
    {
      "name": "9. GET /api/registrations (Filtered by Event ID)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
